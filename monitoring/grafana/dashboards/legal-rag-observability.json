  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "legal-rag-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum by (route) (rate(legal_rag_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "legal-rag-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "100 * sum(rate(legal_rag_http_errors_total[$__rate_interval])) / clamp_min(sum(rate(legal_rag_http_requests_total[$__rate_interval])), 0.000001)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "title": "HTTP error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "legal-rag-prometheus"},
